{
    "name": "omnibridge/parity-laravel",
    "description": "The reference application of omnibridge/parity under Laravel, through omnibridge/laravel.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.2",
        "doctrine/orm": "^3.5",
        "laravel/framework": "^13.0",
        "omnibridge/doctrine": "1.x-dev",
        "omnibridge/laravel": "1.x-dev",
        "omnibridge/twig": "1.x-dev",
        "omnisense/omnibase": "5.x-dev",
        "omnisense/omnibridge": "1.x-dev"
    },
    "autoload": {
        "psr-4": {
            "App\\": "../../app/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "omnibridge/composer": false,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
