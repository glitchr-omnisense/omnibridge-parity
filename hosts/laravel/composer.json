{
    "name": "omnibridge/parity-laravel",
    "description": "The reference application of omnibridge/parity under Laravel, through omnibridge/laravel.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.2",
        "doctrine/orm": "^3.5",
        "laravel/framework": "^13.0",
        "omnibridge/doctrine": "^1.0.1",
        "omnibridge/eloquent": "^1.0",
        "omnibridge/laravel": "^1.1.1",
        "omnibridge/twig": "^1.0",
        "omnisense/omnibase": "^5.1.1",
        "omnisense/omnibridge": "^1.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "../../app/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "omnibridge/composer": false,
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}
