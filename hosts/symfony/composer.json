{
    "name": "omnibridge/parity-symfony",
    "description": "The reference application of omnibridge/parity under Symfony, through omnibridge/symfony (omnibase's BaseBundle).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/orm": "^3.5",
        "omnibridge/doctrine": "1.x-dev",
        "omnibridge/symfony": "1.x-dev",
        "omnibridge/twig": "1.x-dev",
        "omnisense/omnibase": "5.x-dev",
        "omnisense/omnibridge": "1.x-dev",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": [
                "src/",
                "../../app/src/"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "omnibridge/composer": false,
            "symfony/flex": false,
            "symfony/runtime": false
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
