<?xml version="1.0" encoding="UTF-8"?>
<!-- The suites, every cell asked over HTTP (PARITY_CELLS), run by compose's "parity" service: Parity (the pages) and
     Repositories (the application's repositories, the lifecycle listener). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheResult="false"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
>
    <testsuites>
        <testsuite name="Parity">
            <directory>tests/Parity</directory>
        </testsuite>
        <testsuite name="Repositories">
            <directory>tests/Repositories</directory>
        </testsuite>
    </testsuites>
</phpunit>
